#include <stdio.h>

#define MAX 100

int main() {
    int n, m, i, u, v;
    int adj[MAX][MAX] = {0};
    int directed;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &m);

    printf("Is the graph directed? (1 = Yes, 0 = No): ");
    scanf("%d", &directed);

    // Initialize matrix to 0
    for(i = 0; i < n; i++)
        for(int j = 0; j < n; j++)
            adj[i][j] = 0;

    // Input edges
    printf("Enter edges (u v):\n");
    for(i = 0; i < m; i++) {
        scanf("%d %d", &u, &v);

        adj[u][v] = 1;

        if(!directed)
            adj[v][u] = 1;
    }

    // Print adjacency matrix
    printf("\nAdjacency Matrix:\n");
    for(i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            printf("%d ", adj[i][j]);
        }
        printf("\n");
    }

    return 0;
}
